# Oppsett for pull_backup.sh. Kopier til ~/.config/enk_norge/backup.env (modus 600)
# og fyll ut. Fila leses som shell.

# SSH-mål for serveren som kjører server_backup.sh (må virke uten passord).
BACKUP_REMOTE='root@server.example'
# Mappen på serveren med backupene (ARCHIVE_ROOT i server_backup.sh: <ERPNEXT_DIR>/enk-backups).
BACKUP_REMOTE_ROOT='/srv/erpnext/enk-backups'

# Valgfritt:
#BACKUP_LOCAL_ROOT="$HOME/backups/erpnext"   # lokal mappe for de krypterte kopiene
#BACKUP_KEEP_DAYS=90                         # slett lokale kopier eldre enn dette
